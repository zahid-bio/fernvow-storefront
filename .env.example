# Fernvow Storefront Environment Reference
# Copy these placeholders into your deployment configuration or local config loader.
# Never commit live credentials or Admin API secrets.

FERNVOW_STOREFRONT_MODE=preview
FERNVOW_PRIMARY_DOMAIN=fernvow.com
FERNVOW_MARKET=US
FERNVOW_CURRENCY=USD

# Shopify Storefront API (public Storefront token only; never Admin API secret)
SHOPIFY_STORE_DOMAIN=
SHOPIFY_STOREFRONT_ACCESS_TOKEN=
SHOPIFY_STOREFRONT_API_VERSION=2026-01

# Shopify ProductVariant GIDs (populate after syncing Selfnamed SKUs in Shopify)
FERNVOW_SHOPIFY_VARIANT_FOAM=
FERNVOW_SHOPIFY_VARIANT_MOISTURIZER=
FERNVOW_SHOPIFY_VARIANT_TONER=
FERNVOW_SHOPIFY_VARIANT_DUO=
